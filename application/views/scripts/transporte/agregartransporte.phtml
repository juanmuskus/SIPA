
<div class="container col-sm-4 col-md-6 col-lg-9" style="margin-top: 20px;">
<h3 class="text-center" style="font-family:robotoblack;font-size:23px;color:#777"> Agregar Vehiculo</h3>     
<br>
<div class="panel panel-success">  
<div class="panel-heading" style="font-family:robotoblack;font-size:18px;color:#777"> Datos del vehiculo</div>   
<div class="panel-body">
    <form id="tra">
     <div class="row">
      <div class="col-lg-6">    
      <div class="form-group">
      <label for="input" class="" style="font-family:aleolight;font-size:14px;color:#000">Nombre de la Placa</label>           
      <input type="text" class="form-control" id="placa" name="placa"> 
      </div>    
      </div>
       <div class="col-lg-6">   
       <div class="form-group">
       <label for="input" class="" style="font-family:aleolight;font-size:14px;color:#000">Descripción</label>           
       <input type="text" class="form-control"  id="descri" name="descri"> 
       </div>    
       </div> 
       </div>   
      <br>
    <div class="row">
      <div class="col-lg-6">   
      <div class="form-group">
      <label for="input" class="" style="font-family:aleolight;font-size:14px;color:#000">tipo_vehiculo</label>           
      <select class="form-control" id="vehi" name="vehi" style="cursor:pointer;">
      <option value="0">Seleccione Opción ..</option>      
      <option>Gasolina</option>
      <option>Diesel</option>   
      <option>Gas</option> 
       </select> 
      </div>    
      </div> 
      <div class="col-lg-6">    
      <div class="form-group">
      <label for="input" class="" style="font-family:aleolight;font-size:14px;color:#000">Estado Vehiculo</label>           
      <select class="form-control" id="estado" name="estado" style="cursor:pointer;">
      <option value="0">Seleccione Opción ..</option>   
      <option>Carro Nuevo</option>
      <option>Carros Viejo</option>
      <option>Carro Bueno</option>   
      <option>Carro Regular</option> 
       </select> 
      </div>    
      </div>  
    </div> 
     <br>
    <div class="row">
      <div class="col-lg-6"> 
      <div class="form-group">
      <label for="input" class="" style="font-family:aleolight;font-size:14px;color:#000">Capacidad de Pasajeros</label>           
      <input type="text" class="form-control"  id="pasa" name="pasa"> 
      </div>    
      </div>    
    </div> 
    </form>
 
</div>
</div>    
   <div class="row">
   <div class=" text-center">
   <input type="button" id="agregar" value="Guardar"  class="btn btn-default" style="font-family:aleobold;font-size:18px;color:#1d9d74" />  
   </div>          
   </div>  
</div>
